# Direct endpoints for EVERY node; keys must be stable across backup runs.
export QDRANT_NODES='{"qdrant-0":"http://qdrant-0.qdrant-headless:6333","qdrant-1":"http://qdrant-1.qdrant-headless:6333","qdrant-2":"http://qdrant-2.qdrant-headless:6333"}'
export QDRANT_API_KEY=replace-me
# Optional endpoint for listing collections; backups always use QDRANT_NODES.
export QDRANT_URL=http://localhost:6333
export QDRANT_TIMEOUT=30m

export S3_BUCKET=qdrant-snapshots
export AWS_REGION=eu-west-1
export S3_TIMEOUT=30m
# Only for local RustFS or another S3-compatible endpoint:
# export S3_ENDPOINT=http://localhost:9000
# export S3_FORCE_PATH_STYLE=true
# export AWS_ACCESS_KEY_ID=qdrant
# export AWS_SECRET_ACCESS_KEY=qdrant-secret
# In Kubernetes, use AWS workload identity instead of static keys.

export RETENTION_KEEP_LAST=5
# Optional telemetry; without an endpoint the CLI operates offline.
# export OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# export OTEL_SERVICE_NAME=qdrant-maintenance

# Local and OpenTelemetry log threshold: DEBUG, INFO (default), WARN, ERROR.
export LOG_LEVEL=INFO
